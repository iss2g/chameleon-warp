# Optional settings for Chameleon Warp. Copy to `.env` and uncomment what you
# want to change. Read by `docker compose` and by scripts/start.sh /
# scripts/start.ps1. Full reference: docs/CONFIGURATION.md

# ---- launcher ----
# PORT=8000                 # port the app listens on
# HOST=127.0.0.1            # native start scripts only; 0.0.0.0 = reachable from your LAN
# WITH_BLENDER=1            # docker only: 0 = build without Blender (no FBX)

# ---- storage & sessions ----
# DT_WORKSPACE_ROOT=        # where sessions live (default: backend/workspace, /data/workspace in Docker)
# DT_SESSION_TTL_SECONDS=604800          # idle session lifetime, default 7 days
# DT_MAX_TOTAL_STORAGE_BYTES=53687091200 # 50 GB across all sessions, LRU-evicted above it (0 = off)
# DT_MAX_SESSION_STORAGE_BYTES=1073741824

# ---- mesh limits ----
# DT_MAX_UPLOAD_BYTES=209715200
# DT_MAX_SOURCE_TRIANGLES=100000
# DT_MAX_TARGET_TRIANGLES=1500000
# DT_MAX_TARGET_TRIANGLES_DT=100000
# DT_MAX_POSES_PER_SESSION=250

# ---- performance ----
# DT_COMPUTE_CONCURRENCY=1  # heavy jobs at once; the math is CPU-bound
# MKL_NUM_THREADS=          # cap BLAS threads (default: all cores)
# OMP_NUM_THREADS=
# DT_LAYER_WORKERS=         # processes for Refit's auto layer detection, default min(cores, 8)

# ---- logging ----
# DT_LOG_JSON=0
# DT_LOG_FILE=              # also write rotated logs to this file

# ---- Blender (native install) ----
# BLENDER_PATH=/path/to/blender   # if it isn't on PATH / in the default location
